# .env — ClauseGuard v2 Environment Variables
# Copy this file to `.env` and fill in your key.
# The app loads this file automatically via python-dotenv.
#
# IMPORTANT: No spaces around = and no quotes around values.

# ── LLM Provider (only ONE key is needed) ────────────────────────────────────

# Option A: Groq — PREFERRED (free tier, fast, keys start with "gsk_")
# Get your free key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Option B: xAI Grok (keys start with "xai-")
# Get your key from: https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here

# Option C: OpenAI GPT-4o (keys start with "sk-")
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ── Optional Settings ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO
